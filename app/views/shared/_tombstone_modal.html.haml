-# Tombstone confirm modal — used on community/collection/work show pages.
-#
-# Locals:
-#   id            — the resource ID, used to scope modal/label DOM ids
-#   kind          — human noun ("community", "collection", "work")
-#   path          — POST route that performs the tombstone
-#   trigger_class — class string for the trigger link (matches the
-#                   sibling Edit link on the host page).
- modal_id = "tombstone-modal-#{id}"
- label_id = "tombstone-label-#{id}"
- reason_id = "tombstone-reason-#{id}"
- trigger_class = local_assigns.fetch(:trigger_class, 'px-3')

= link_to 'Delete', "##{modal_id}", class: trigger_class, data: { 'bs-toggle': 'modal' }

.modal.fade{id: modal_id, tabindex: '-1', 'aria-labelledby': label_id, 'aria-hidden': 'true'}
  .modal-dialog.modal-dialog-centered
    -# `text-start` and `text-wrap` defend against the `.text-end` and
    -# `.text-nowrap` ancestors on the host page (e.g. works/show) bleeding into
    -# the modal contents.
    .modal-content.text-start.text-wrap
      .modal-header
        %h5.modal-title{id: label_id} Confirm deletion
        %button.btn-close{type: 'button', 'aria-label': 'Close', data: { 'bs-dismiss': 'modal' }}
      -# The reason is what the item's removal page shows. Its wording is fixed
      -# by the withdrawal policy, and Atlas refuses anything else.
      = form_with url: path, method: :post do
        .modal-body
          %p
            Are you sure you want to delete this
            = "#{kind}?"
          - if chooses_removal_reason?
            %p.small.text-muted
              This item will no longer be accessible. Its page will show the reason you choose.
            %label.form-label{for: reason_id} Reason for removal
            = select_tag :reason, options_for_select(TombstoneReasons::ALL),
                         id: reason_id, class: 'form-select', required: true,
                         include_blank: 'Choose a reason'
          - else
            = hidden_field_tag :reason, TombstoneReasons::CURATOR, id: nil
            %p.small.text-muted.mb-0
              This item will no longer be accessible. Its page will say that it was
              removed at the contributor or content curator's discretion.
        .modal-footer
          %button.btn.btn-secondary{type: 'button', data: { 'bs-dismiss': 'modal' }} Cancel
          %button.btn.btn-danger{type: 'submit'} Delete
