%nav{"aria-label" => "breadcrumb"}
  %ol.breadcrumb.align-items-center
    - breadcrumb_trail do |crumb|
      -# aria-current sits on the item, as in Bootstrap's own markup: the
      -# current crumb renders as bare text, and link_to_unless drops the
      -# options it would otherwise carry.
      %li.breadcrumb-item{class: crumb.current? ? "active" : "", 'aria-current': ('page' if crumb.current?)}
        = link_to_unless crumb.current?, enhanced_text(crumb.name), crumb.url
    -# The "Add a child here" affordance, gated on @can_edit (set by the show
    -# page) for every branch — you may only add a child to a container you can
    -# edit. Atlas enforces the same rule on the write (:create_child, resolved
    -# against the destination), so an ungated link leads only to a 403.
    -# Suppressed on edit pages via `show_add: false`: you don't add
    -# siblings/children mid-edit.
    - if local_assigns.fetch(:show_add, true) && user_signed_in? && @can_edit
      -# Where the side has no room, the menu drops below rather than flipping
      -# left over the trail. This config replaces Bootstrap's modifiers
      -# wholesale, so the offset (the arrow's gap) has to live here too.
      - add_popper = { modifiers: [{ name: "preventOverflow", options: { boundary: "clippingParents", padding: 16 } },
                                   { name: "offset", options: { offset: [-8, 16] } },
                                   { name: "flip", options: { fallbackPlacements: ["bottom-start"] } }] }
      %li.breadcrumb-item
        .dropend.breadcrumb-add
          %button#breadcrumb-add-toggle.breadcrumb-add__toggle{"aria-expanded" => "false", "data-bs-toggle" => "dropdown", "data-bs-popper-config" => add_popper.to_json, :type => "button"}
            %i.fa-regular.fa-square-plus{'aria-hidden' => 'true'}
            %span.ms-1 Add
          %ul.dropdown-menu{"aria-labelledby" => "breadcrumb-add-toggle"}
            = render 'shared/add_menu_items', add_to_collection: local_assigns[:add_to_collection]
    - if block_given?
      = yield
