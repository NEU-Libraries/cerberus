.admin-registry.my-3
  %header.admin-registry__head
    %span.admin-registry__title
      %i.fa-solid.fa-cloud-arrow-up{'aria-hidden' => 'true'}
      New upload
      %span.text-muted.fw-normal to #{@loader.display_name}
    %span.admin-registry__subtitle
      %i.fa-solid.fa-folder-tree{'aria-hidden' => 'true'}
      = @loader.slug
  .admin-registry__body
    -# archive-upload intercepts the submit to report real upload bytes; see
    -# the controller for why Turbo's own bar cannot be used here.
    = form_with model: [@loader, @load_report], url: loader_loads_path(@loader), local: true,
                html: { class: 'admin-registry-form', multipart: true,
                        data: { controller: 'archive-upload',
                                action: 'submit->archive-upload#submit' } } do |f|
      - if @load_report.errors.any?
        .alert.alert-danger
          %p.fw-semibold.mb-1
            %i.fa-solid.fa-circle-exclamation.me-1{'aria-hidden' => 'true'}
            Couldn't begin this batch.
          %ul.mb-0.small
            - @load_report.errors.full_messages.each do |msg|
              %li= msg
      - if flash.now[:alert]
        .alert.alert-warning
          %i.fa-solid.fa-triangle-exclamation.me-1{'aria-hidden' => 'true'}
          = flash.now[:alert]

      .admin-registry-form__section
        .mb-0
          = f.label :archive, class: 'admin-registry-form__label' do
            %i.fa-solid.fa-file-zipper{'aria-hidden' => 'true'}
            Archive file
          = f.file_field :archive, class: 'form-control', accept: '.tar,.zip', required: true,
                          data: { 'archive-upload-target' => 'file' }
          - if @loader.multipage?
            .admin-registry-form__hint
              Accepted formats:
              %code.admin-registry-table__id .tar
              or
              %code.admin-registry-table__id .zip
              \. Must contain a
              %code.admin-registry-table__id manifest.xlsx
              listing one or more items. Each item is a MODS XML (Sequence 0) followed by its page images in order (Sequence 1 and up), with Last Item on that item's final page. Every item becomes its own Work with ordered pages; you'll preview the first item before the batch runs.
          - elsif @loader.xml?
            .admin-registry-form__hint
              Archive packages larger than 2GB must use the
              %code.admin-registry-table__id .tar
              format. All other packages may use
              %code.admin-registry-table__id .zip
              \. New file ingests must contain files and MODS XML files. Metadata overwrite submissions should only contain MODS XML files. Every archive package must contain a manifest named
              %code.admin-registry-table__id manifest.xlsx
              \.
          - else
            .admin-registry-form__hint
              Accepted formats:
              %code.admin-registry-table__id .tar
              or
              %code.admin-registry-table__id .zip
              \. Each JPEG inside must carry valid IPTC tags — Headline and Keywords are required; By-line, Description, Category, City + State are optional but recorded.

      .admin-registry-form__section
        .mb-0
          = f.label :parent_collection_id, class: 'admin-registry-form__label' do
            %i.fa-solid.fa-folder-open{'aria-hidden' => 'true'}
            Destination collection
          - if @loader.iptc?
            -# IPTC safety rail: boxed to the configured root collection's children.
            - if @destinations.any?
              = f.select :parent_collection_id,
                         options_for_select(@destinations.map { |c| [c.title, c.id] }, @load_report.parent_collection_id),
                         { include_blank: 'Select a collection…' },
                         class: 'form-select admin-registry-form__input--id', required: true
            - else
              .alert.alert-warning.mb-0
                %i.fa-solid.fa-triangle-exclamation.me-1{'aria-hidden' => 'true'}
                No destination collections found under
                %code.admin-registry-table__id= @loader.root_collection
                \. Ask an admin to verify the loader's root collection is configured correctly.
          - else
            -# XML / multipage: librarian-trusted — pick any collection by title
            -# (NOID shown for visual confirmation) or paste a NOID directly.
            .position-relative{ data: { controller: 'collection-picker',
              collection_picker_url_value: collection_search_loader_loads_path(@loader) } }
              %input.form-control.admin-registry-form__input--id#load_report_collection_query{ type: 'text',
                autocomplete: 'off', placeholder: 'Search by collection title, or paste a PID…',
                value: @load_report.parent_collection_id,
                data: { collection_picker_target: 'query', action: 'input->collection-picker#search' } }
              = f.hidden_field :parent_collection_id, data: { collection_picker_target: 'hidden' }
              .list-group.inbox-typeahead{ hidden: true, data: { collection_picker_target: 'results' } }
            - if @loader.multipage?
              .admin-registry-form__hint
                Where the new multipage Works land — any collection.
            - else
              .admin-registry-form__hint
                A destination collection is not required for metadata overwrite packages.

      -# Hidden until a submit starts. role=progressbar without aria-valuenow reads
      -# as indeterminate, which is exactly the state after the last byte is sent
      -# and before the server answers.
      .archive-upload.mt-4{ hidden: true, role: 'progressbar',
        'aria-valuemin' => 0, 'aria-valuemax' => 100,
        data: { 'archive-upload-target' => 'panel' } }
        .archive-upload__head
          %span.archive-upload__label{ data: { 'archive-upload-target' => 'label' } } Uploading
          %span.archive-upload__percent{ data: { 'archive-upload-target' => 'percent' } } 0%
        .archive-upload__track
          .archive-upload__fill{ style: 'width: 0%', data: { 'archive-upload-target' => 'fill' } }
        -# The icon sits outside the target, because the controller rewrites the
        -# note with textContent and would otherwise delete it.
        .archive-upload__note
          %i.fa-solid.fa-circle-info.me-1{'aria-hidden' => 'true'}
          %span{ data: { 'archive-upload-target' => 'note' } } Keep this tab open until the upload finishes.

      .d-flex.gap-2.align-items-center.mt-4
        = f.submit 'Upload', class: 'btn btn-primary',
                   disabled: (@loader.iptc? && @destinations.empty?),
                   data: { 'archive-upload-target' => 'submit' }
        = link_to loader_loads_path(@loader), class: 'btn btn-warning' do
          Cancel
