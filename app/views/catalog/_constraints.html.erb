<div class="search-results-header d-flex align-items-baseline flex-wrap gap-4 mt-2 mb-2">
  <% if params[:q].present? || whole_tree_label %>
    <h1 class="search-results-header__title h4 mb-0 text-nowrap">
      <i class="fa-solid fa-magnifying-glass me-2" aria-hidden="true"></i><%= t('blacklight.search.search_results') %>
    </h1>
  <% end %>
  <div class="search-results-header__constraints flex-grow-1">
    <%# The component's own heading names the constraint list for a screen
        reader. Blacklight styles it as visible text, which on this row reads
        as a second title competing with the h1 beside it — so it is kept for
        assistive tech and taken out of the visual flow.
        Cerberus's subclass, named here rather than in the view config, adds
        the empty-search chip (whole_tree_label is nil everywhere else). %>
    <%= render Cerberus::ConstraintsComponent.new(
          search_state: search_state, heading_classes: 'constraints-label visually-hidden',
          whole_tree_label: whole_tree_label
        ) %>
  </div>
</div>
