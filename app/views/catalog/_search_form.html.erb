
  <h5 class="mt-1">
    <i class="fa-solid fa-box-archive fa-sm d-none d-xl-inline-block" aria-hidden="true"></i>
    <a class="navbar-brand" href="/">
      DRS · Digital Repository Service
    </a>
  </h5>

  <%# The column classes size the form against the wordmark beside it.
      Blacklight sets them on its own search bar rather than on
      .search-query-form, so they have to be named here — without a width the
      form grows to fill the navbar row and wraps the wordmark onto two
      lines. %>
  <%= form_tag('/catalog', method: :get, class: 'search-query-form container-fluid me-0 pe-0 col-md-12 col-lg-8') do -%>
    <%# Carries the search state (facets, sort, per page) into the next search,
        less what must not travel: the query, which the box below supplies,
        and the route's own parameters (controller, action, a page's id).
        HiddenSearchStateComponent drops only page and utf8. A plain hash,
        because it unpacks nested values only from a Hash, and Parameters is
        not one: a facet filter would otherwise travel as one garbled field. %>
    <%= render Blacklight::HiddenSearchStateComponent.new(
          params: params.except(:q, :search_field, *request.path_parameters.keys).to_unsafe_h
        ) %>
    <div class="input-group">
      <input type="text" class="form-control" placeholder="Search..." id="q" name="q" value="<%= params[:q] %>" aria-label="Search the repository">
      <button class="btn btn-primary" type="submit">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        Search
      </button>
    </div>
  <% end -%>
