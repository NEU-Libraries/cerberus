
  <h5 class="mt-1">
    <i class="fa-solid fa-box-archive fa-sm d-none d-xl-inline-block"></i>
    <a class="navbar-brand" href="/">
      DRS · Digital Repository Service
    </a>
  </h5>

  <%# The column classes size the form against the wordmark beside it.
      Blacklight sets them on its own search bar rather than on
      .search-query-form, so they have to be named here — without a width the
      form grows to fill the navbar row and wraps the wordmark onto two
      lines. %>
  <%= form_tag('/catalog', method: :get, class: 'search-query-form container-fluid me-0 pe-0 col-md-12 col-lg-8') do -%>
    <%= render Blacklight::HiddenSearchStateComponent.new(params: params) %>
    <div class="input-group">
      <input type="text" class="form-control" placeholder="Search..." id="q" name="q" value="<%= params[:q] %>">
      <button class="btn btn-primary" type="submit">
        <i class="fa-solid fa-magnifying-glass"></i>
        Search
      </button>
    </div>
  <% end -%>
