<%# Cerberus override of Blacklight's catalog/_zero_results.

    Two empty states, one look. A search or a filter that matched nothing gets
    the next steps that apply to it, each with its link. A browse into an empty
    container (communities, collections, genres) never ran a search, so search
    advice is nonsense there: it gets a calm "this is empty" instead.

    The sidebar is not mounted on an empty response (catalog/_search_sidebar),
    so both states run full width.

    A genre landing carries its genre as a filter on a legacy link, so only
    typed words make it a search. %>
<% if params[:q].present? || (search_state.filters.any? && controller_name != 'genres') %>
  <% query = params[:q].to_s.strip %>
  <% scoped_field = params[:search_field].presence && params[:search_field] != blacklight_config.default_search_field&.key %>
  <div id="documents" class="empty-container-state noresults">
    <i class="empty-container-state__icon fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    <h2 class="empty-container-state__title">
      <%= query.present? ? "No results for “#{query}”" : 'No items match these filters' %>
    </h2>
    <p class="empty-container-state__hint">No item you have access to matches this search.</p>
    <ul class="empty-container-state__steps">
      <% if query.present? %>
        <li><%= t 'blacklight.search.zero_results.use_fewer_keywords' %></li>
      <% end %>
      <% if query.present? && scoped_field %>
        <li>
          <%= link_to "Search all fields",
                      url_for(search_state.params_for_search(search_field: blacklight_config.default_search_field.key)) %>
          instead of only <%= search_field_label(params) %>.
        </li>
      <% end %>
      <% if search_state.filters.any? %>
        <li>
          <%= link_to 'Remove the filters', search_action_path(q: params[:q].presence, search_field: params[:search_field].presence) %>
          and keep only your search words.
        </li>
      <% end %>
      <% unless user_signed_in? %>
        <li>
          <%= link_to 'Sign in', sign_in_path_for_environment %>
          to include items shared only with the Northeastern community.
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  <% kind, icon = case controller_name
                  when 'collections' then ['collection', 'fa-folder-open']
                  when 'communities' then ['community',  'fa-users']
                  when 'genres'      then ['category',   FeaturedContent.icon_for(@genre) || 'fa-bookmark']
                  else [nil, 'fa-box-open']
                  end %>
  <div id="documents" class="empty-container-state">
    <i class="empty-container-state__icon fa-solid <%= icon %>" aria-hidden="true"></i>
    <h2 class="empty-container-state__title">
      <%= kind ? "This #{kind} is empty" : 'Nothing here yet' %>
    </h2>
    <p class="empty-container-state__hint">Nothing has been added yet.</p>
  </div>
<% end %>
