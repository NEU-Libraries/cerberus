%h3 Create new Community

-# The destination is the nested route's parent segment (@create_path), not a
-# form field — you say where a Community goes by navigating there.
= bootstrap_form_tag url: @create_path do |f|
  = bootstrap_fields_for :community do |c|
    = c.text_field :title, required: true
    = c.text_area :description, rows: 10
  = f.button :submit, class: "btn btn-primary my-3"
