- content_for(:page_title) { 'Edit details' }

- content_for(:container_header) do
  = render 'shared/breadcrumbs'

.admin-registry.my-3
  %header.admin-registry__head
    %span.admin-registry__title
      %i.fa-solid.fa-user-pen{'aria-hidden' => 'true'}
      Edit details
      %span.admin-registry__who= @person['display_name']

  .admin-registry__body
    = form_with scope: :person, url: person_path(@noid), method: :patch, class: 'admin-registry-form' do |f|
      .admin-registry-form__section
        %h3.admin-registry-form__section-title
          %i.fa-solid.fa-signature{'aria-hidden' => 'true'}
          Name
        .mb-3
          = f.label :display_name, class: 'admin-registry-form__label' do
            %i.fa-solid.fa-signature{'aria-hidden' => 'true'}
            Display name
          = f.text_field :display_name, value: @values['display_name'], class: 'form-control', autocomplete: 'name', required: true
          .admin-registry-form__hint The name shown on your profile and beside your works.

      = render 'admin/people/profile_fields', f: f, pv: @values

      .well.p-3.my-3.rounded-3
        = f.submit 'Save details', class: 'btn btn-success'
        = link_to 'Cancel', person_path(@noid), class: 'btn btn-warning'
