-# The destination is the route's parent segment, so this form only asks what to
-# deposit — and, from the depositor's own root, whether to also promote it.
= form_tag(@create_path, multipart: true, class: 'deposit-form my-3', data: (@publish_targets.present? ? { controller: 'deposit-promotion', 'deposit-promotion-genres-value': @publish_targets.transform_values { |target| target[:genres] }, 'deposit-promotion-requires-proxy-value': @publishing_for.present? } : {})) do |f|

  .deposit-form__panel
    %header.deposit-form__head
      %div
        %span.deposit-form__eyebrow Step 1 of 2: submit file
        %span.deposit-form__title Deposit

    .deposit-form__body
      .deposit-form__field
        %span.deposit-form__field-label Depositing into
        .well.p-3.rounded-3
          .deposit-form__radio-title
            %i.fa-solid.fa-folder-open{'aria-hidden' => 'true'}
            = @publishing_for ? "#{@publishing_for['display_name']}’s workspace" : enhanced_text(@parent.title)
          .deposit-form__radio-desc.mt-1
            The new work will be added to this collection.

      -# Promotion — an optional extra act, not a destination. Offered only into
      -# a person's personal root (WorksController#publish_offered?), which keeps a
      -# promoted Work in their own space. In someone else's workspace it waits
      -# under Ownership for a proxy deposit instead; see below.
      - if @publish_targets.present? && @publishing_for.nil?
        = render 'works/promote', targets: @publish_targets, owner: nil

      .deposit-form__field
        %label.deposit-form__field-label{for: 'binary'} File
        = file_field_tag 'binary', class: 'deposit-form__file', required: true
        %p.deposit-form__field-hint
          One file per deposit.

      -# Hidden during an acting-as session: impersonation already fixes the
      -# attribution (to the target), so offering the proxy radio would be a
      -# second, conflicting attribution mechanism. See WorksController#deposit_attribution.
      - if offers_proxy_deposit?
        %fieldset.deposit-form__field
          %legend.deposit-form__field-label Ownership
          .deposit-form__radio-grid
            %label.deposit-form__radio{for: 'upload_as_myself'}
              = radio_button_tag 'upload_as', 'myself', true, class: 'deposit-form__radio-input', id: 'upload_as_myself', data: { action: 'deposit-promotion#proxyChanged' }
              .deposit-form__radio-body
                .deposit-form__radio-title
                  %i.fa-solid.fa-user{'aria-hidden' => 'true'}
                  Self-deposit
                .deposit-form__radio-desc
                  You will be recorded as the depositor in the audit trail.
            %label.deposit-form__radio{for: 'upload_as_proxy'}
              = radio_button_tag 'upload_as', 'proxy', false, class: 'deposit-form__radio-input', id: 'upload_as_proxy', data: { action: 'deposit-promotion#proxyChanged' }
              .deposit-form__radio-body
                .deposit-form__radio-title
                  %i.fa-solid.fa-people-arrows{'aria-hidden' => 'true'}
                  Proxy deposit
                .deposit-form__radio-desc
                  You are depositing this file on behalf of the collection owner. You will be recorded as the proxy depositor in the audit trail and the collection owner will be recorded as the depositor.

      - if @publish_targets.present? && @publishing_for
        = render 'works/promote', targets: @publish_targets, owner: @publishing_for

      -# Checked again on the server; the acceptance itself is not recorded.
      .deposit-form__field
        %span.deposit-form__field-label Terms
        .form-check
          = check_box_tag 'terms_accepted', '1', false, class: 'form-check-input', id: 'terms_accepted', required: true
          %label.form-check-label{for: 'terms_accepted'}
            I have read and I accept the
            = succeed "." do
              = link_to 'Terms of Participation', terms_path, target: '_blank', rel: 'noopener'
        %p.deposit-form__field-hint
          The terms open in a new tab.

  .deposit-form__actions
    .deposit-form__next-hint
      %i.fa-solid.fa-arrow-right{'aria-hidden' => 'true'}
      Next step: Review and confirm the descriptive metadata.
    = submit_tag "Upload", class: 'btn btn-primary deposit-form__submit'
