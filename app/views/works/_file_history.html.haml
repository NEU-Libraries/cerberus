-# Each replaced file's versions, newest first. Atlas lists only files with more
-# than one version, so a work whose files were never replaced has no card.
-# See docs/downloads.md.
- entries = file_history_entries(files, file_revisions)
- return if entries.empty?

#file-history.card.mb-4
  .card-header
    %h2.h5.mb-0 File history
  %ul.list-group.list-group-flush
    - entries.each do |file, revisions|
      - label = download_label(file)
      %li.list-group-item
        %table.table.table-sm.w-auto.mb-0
          %caption.caption-top.pt-0.pb-2
            %span.fw-semibold.text-body= label
            %span.text-subtle.small.ms-2 File ID
            %span.admin-registry-table__id= file.noid
          %thead
            %tr
              %th.pe-5{scope: 'col'} Version
              %th{scope: 'col'} Uploaded
          %tbody
            - revisions.each_with_index do |revision, i|
              %tr
                %td
                  %span.admin-registry-table__id= revision['revision']
                  - if i.zero?
                    %span.badge.rounded-pill.text-bg-light.ms-1 current
                %td.admin-registry-table__when.small= file_version_when(revision['created'])
