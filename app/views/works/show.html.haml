- content_for(:page_title) do
  = plain_text(@work.title)
- content_for(:container_header) do
  = render 'shared/breadcrumbs'

= render 'scholar_metadata', scholar: @scholar

-# Only the assets the viewer may actually fetch — inaccessible gated tiers
-# and, while under embargo, every tier (unless the viewer can bypass it) are
-# kept out of the card, its modal, and the count.
- downloads = downloadable_files(@files, embargo_date: @permissions&.embargo)
- embargo_date = Embargo.release_date(@permissions&.embargo)

.container
  .clearfix.pt-1
  - if embargo_date&.future?
    .row
      .col-12
        %p.text-danger.small.mb-2
          %i.fa-solid.fa-clock.me-1{'aria-hidden' => 'true'}
          This item is under embargo and its content will be available for download and viewing on
          = "#{embargo_date.strftime('%B %-d, %Y')}."
  .row
    .col-12
      .d-flex.flex-column.flex-md-row.justify-content-md-between.align-items-md-end
        %h3= enhanced_text(@work.title)
        - if user_signed_in?
          .text-end.small.pb-2.flex-shrink-0.text-nowrap
            - if @can_edit && !@work.in_progress
              -# Full reload rather than a Turbo visit: the edit page picks its active
              -# tab from the URL fragment after the document loads, so a Turbo swap can
              -# show the previous pane for a frame before tab-hash corrects it.
              = link_to "Edit", edit_work_path(@work.id), class: "px-2", data: { turbo: false }
            - if @can_tombstone
              = render 'shared/tombstone_modal',
                       id:            @work.id,
                       kind:          'work',
                       path:          tombstone_work_path(@work.id),
                       trigger_class: 'px-2'
            -# Rebuilds this work's search record from Atlas. Solr-only and
            -# idempotent, so it is safe to offer as a one-click repair for a
            -# record that has gone stale against a changed indexer.
            -#
            -# A POST, so button_to rather than link_to. `link-action` strips the
            -# button chrome back to a plain link, because the rest of this row
            -# is plain links and a repair action should not outrank Edit.
            - if current_user&.admin? || current_user&.admin_delegate?
              = button_to 'Reindex', admin_reindex_work_path(@work.id),
                          class:      'btn btn-link link-action px-2',
                          form_class: 'd-inline',
                          title:      'Rebuild this work’s search record'
      %hr.section-divider
      -# Both halves of this row are conditional, so the row itself goes when
      -# neither has anything to say — an empty flex row would still carry its
      -# bottom margin and open a gap under the divider.
      - permanent_url = handle_url(@work.handle)
      - if permanent_url.present? || downloads.present?
        .d-flex.justify-content-between.align-items-center.mb-3.small
          = render 'permanent_url', url: permanent_url
          - if downloads.present?
            = link_to '#downloads' do
              %span.text-muted= "Downloads (#{downloads.size})"
              %i.fa-solid.fa-arrow-down.ms-1{'aria-hidden' => 'true'}
  .row
    .col-md-6.order-md-1.order-2
      - if @multipage && @can_zoom
        -# Page-turning deep-zoom viewer (Tify) over the work's IIIF
        -# manifest, in the slot the static thumbnail occupies for
        -# single-page works. Stylesheet ships separately from
        -# application.css and the JS arrives via dynamic import in
        -# iiif_viewer_controller, so other pages never pay for either.
        = stylesheet_link_tag 'tify', 'data-turbo-track': 'false'
        .iiif-viewer{data: { controller: 'iiif-viewer',
                             'iiif-viewer-url-value': manifest_work_path(@work.id) }}
      - elsif @av_file
        -# In-page audio/video player. Like Tify, the skin CSS ships separately
        -# and video.js arrives via dynamic import, so other pages never pay.
        = stylesheet_link_tag 'video-js', 'data-turbo-track': 'false'
        -# The player offers a download link only where this viewer could follow
        -# one, decided by the same per-asset gate as the downloads card.
        = render partial: 'av_player',
                 locals: { file:         @av_file,
                           caption:      @caption,
                           downloadable: derivative_readable?(@av_file, embargo_date: @permissions&.embargo) }
      - else
        = render partial: "thumbnail"
    .col-md-6.order-md-2.order-1
      = @mods.html_safe

.clearfix.mb-4

.container
  .row
    .col-md-12
      = render partial: 'associations', locals: { associations: @associations }
      = render partial: 'downloads', locals: { files: downloads }
