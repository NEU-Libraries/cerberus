-# locals: targets ({ community_noid => { name:, genres: } }), owner (the other
-# person's Person when publishing for them, else nil). See docs/deposit.md.
-#
-# For someone else it is the `promote` target the deposit-promotion controller
-# hides until Proxy deposit is chosen, and starts hidden so it never flashes on
-# a self-deposit.
- name = owner && owner['display_name']
%fieldset.deposit-form__field.deposit-form__promote{ class: ('d-none' if owner),
  data: ({ 'deposit-promotion-target' => 'promote' } if owner) }
  %label.deposit-form__radio{for: 'publish'}
    = check_box_tag 'publish', '1', false, class: 'deposit-form__radio-input', id: 'publish', data: { action: 'deposit-promotion#toggle' }
    .deposit-form__radio-body
      .deposit-form__radio-title
        %i.fa-solid.fa-graduation-cap{'aria-hidden' => 'true'}
        = name ? "Also promote to #{name}’s community showcase" : 'Also promote to a community showcase'
      .deposit-form__radio-desc
        - if name
          Works promoted to #{name}’s community showcase can be discovered by users from the community’s work page and from the DRS homepage. #{name} is the depositor of record, and the work still lives in #{name}’s workspace.
        - else
          Works promoted to a community’s showcase can be discovered by users from the community’s work page and from the DRS homepage.
  .deposit-form__promote-fields.d-none{data: { 'deposit-promotion-target' => 'fields' }}
    -# One category for the Work in every community it is promoted to.
    -# Repopulated by Stimulus as communities are ticked; the genres every
    -# community shares are rendered here as the no-JS fallback.
    - shared = targets.values.map { |target| target[:genres].keys }.reduce(:&)
    %label.deposit-form__field-label{for: 'publish_genre'} Category
    %select.form-select#publish_genre{name: 'publish_genre', data: { 'deposit-promotion-target' => 'genre' }}
      - shared.each do |label|
        %option{value: label}= label
    - if targets.size > 1
      %fieldset.mt-3
        %legend.deposit-form__field-label Communities
        - targets.each_with_index do |(noid, target), index|
          .form-check
            = check_box_tag 'publish_community_ids[]', noid, index.zero?, id: "publish_community_#{noid}", class: 'form-check-input',
                            data: { 'deposit-promotion-target' => 'community', action: 'deposit-promotion#communityChanged' }
            %label.form-check-label{for: "publish_community_#{noid}"}= target[:name]
    - else
      = hidden_field_tag 'publish_community_ids[]', targets.keys.first, id: 'publish_community_only'
