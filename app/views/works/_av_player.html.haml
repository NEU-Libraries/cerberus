-# In-page A/V player (video.js). Audio and video both mount video.js on the
-# Range-capable /media/:id endpoint (seekable); video.js arrives via dynamic
-# import in av_player_controller, so non-A/V pages never pay for it. Every
-# recording mounts on a <video> element, audio in video.js audioPosterMode, so
-# the player always shows a picture while the sound plays, as v1's did: the
-# Work's own poster, else the placeholder mark. video.js wraps a bare <audio>
-# in a 16:9 box it cannot fill, which read as a black screen, and it has nowhere
-# to draw captions. file = the browser-playable Blob (original or the ingest
-# MP4 rendition).
-#
-# captions = the Work's WebVTT Blobs, one per language, English first. They
-# ride /media rather than /downloads deliberately: a caption is part of playing
-# the file, so it must reach anyone who can play it, and the download gate a
-# Streaming Only video closes would otherwise take the subtitles down with the
-# file. video.js grows its own captions menu from the <track>s, so no control
-# is needed here.
- captions = Array(local_assigns[:captions])
- audio = file.mime_type.to_s.start_with?('audio/')
- poster = av_poster_src(@work.preview)
.av-player{data: { controller: 'av-player', 'av-player-audio-poster-value': audio.to_s }}
  %video.video-js.vjs-default-skin.av-player__media{controls: true, preload: 'metadata', playsinline: true, poster: poster, 'data-av-player-target': 'media'}
    %source{src: media_path(file.noid), type: file.mime_type}
    = render 'works/caption_source', captions: captions
  -# `downloadable` comes from the same per-asset gate the downloads card and
  -# DownloadsController use, so a Streaming Only video, a gated tier and an
  -# active embargo all suppress this line alike, and a reader is never told to
  -# download a file the next click would refuse. (v1 advertised its download
  -# link unconditionally and did exactly that.) Decided by the caller rather
  -# than here, so this partial stays presentational.
  - if downloadable
    %p.av-player__fallback.small.mb-0
      %i.fa-solid.fa-circle-info.me-1{'aria-hidden' => 'true'}
      Trouble playing this file?
      = link_to 'Download it', download_path(file.noid), class: 'fw-semibold'
      instead.
  - elsif local_assigns[:streaming_only]
    %p.av-player__fallback.small.mb-0
      %i.fa-solid.fa-circle-info.me-1{'aria-hidden' => 'true'}
      This content can only be viewed in the browser and may not be downloaded for offline viewing or sharing.
