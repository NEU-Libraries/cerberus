-# Atlas's health report for one Work. See docs/work-health.md.
-# @param report [AtlasRb::Mash] Atlas's answer
-# @param work_id [String] the Work's NOID
-# @param standalone [Boolean] true on the admin lookup, which has no tabs
- problems = work_health_problems(report['findings'])
- advisories = work_health_advisories(report['findings'])
.audit-history.work-health.my-3
  %header.audit-history__head
    %div
      %span.audit-history__title Health check
      %span.audit-history__count
        = problems.empty? ? 'No problems' : pluralize(problems.size, 'problem')
    = link_to 'Reload', work_health_reload_path(work_id, standalone:), class: 'btn btn-tonal-secondary btn-sm'
  .work-health__summary{class: work_health_tone(report['grade'])}
    %span.audit-event__action.work-health__grade
      %i.fa-solid.fa-heart-pulse.audit-event__action-icon{'aria-hidden' => 'true'}
      %span.audit-event__action-label= work_health_grade_label(report['grade'])
    -# Always shown: Atlas never re-hashes bytes for this check, so a green
    -# means nothing is missing, not that the bytes were verified.
    %p.small.text-subtle.mb-0.mt-2 Bytes were not re-hashed. A full fixity check runs offline.
  - if problems.any?
    = render 'work_health/findings', findings: problems, work_id:, standalone:,
                                     label: 'Problems found, most severe first'
  - else
    %p.work-health__clear.small.text-subtle.mb-0 Nothing is missing or broken.
  - if advisories.any?
    %details.work-health__advisories
      %summary.small
        = pluralize(advisories.size, 'advisory note')
        %span.text-subtle — states of the Work, not damage
      = render 'work_health/findings', findings: advisories, work_id:, standalone:,
                                       label: 'Advisory notes'
