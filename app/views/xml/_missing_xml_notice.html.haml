-# @param resource [AtlasRb::Mash] the resource being edited
-# @param klass [String] 'Work', 'Collection' or 'Community'
.alert.alert-warning.py-2.px-3.small.d-flex.align-items-start{role: 'alert'}
  %i.fa-solid.fa-triangle-exclamation.me-2.mt-1{'aria-hidden' => 'true'}
  %div
    %strong.d-block The preservation XML for this #{klass} is missing.
    The preview is the access copy. Saving a document here writes a new preservation copy.
    - if klass == 'Work' && can?(:read, :work_health)
      = link_to 'See the Health tab', edit_work_path(resource.id, tab: 'health')
