-# A passing validation clears the refusal banner that a refused Save left above
-# the form. The banner sits outside #mods, so the preview replacement below
-# cannot reach it. A FAILING validation deliberately leaves it alone: nothing
-# was written, so "Not saved" is still true, and the errors themselves render in
-# the preview pane rather than twice on one screen.
- if Array(@errors).empty?
  = turbo_stream.replace 'save_refusal' do
    = render 'save_refusal', errors: [], repairable: false, repaired: false

= turbo_stream.replace "mods" do
  - if @errors.present?
    #mods
      .alert.alert-danger.mt-3{role: "alert"}
        %h5.alert-heading XML validation failed
        %ul.mb-0
          - @errors.each do |err|
            %li= err.to_s
        - if @repairable
          = render 'repair_offer'
  - else
    = @mods.html_safe

  :javascript
    document.querySelectorAll(".loading-state").forEach(function(el){
      el.style.transition = "opacity 500ms";
      el.style.opacity = "0";
      setTimeout(function(){ el.style.visibility = "hidden"; }, 500);
    });
    window.scrollTo(0,0);
