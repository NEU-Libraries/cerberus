- content_for :head do
  = javascript_import_module_tag "preview_application"

-# Breadcrumb rides :container_header so it spans the full main width above the
-# editor, matching the Metadata/Permissions edit pages this is a sub-tab of.
- content_for(:container_header) do
  = render 'shared/breadcrumbs', show_add: false

%h3.py-3
  Edit raw XML for
  = @resource.title

-# This row mirrors the tab set of the edit page it is a sub-tab of
-# (works/collections/communities edit.html.haml) so the XML editor isn't a dead
-# end — each entry links back to the corresponding pane via its tab-hash
-# fragment. Both the membership AND the order differ per class, so they are
-# spelled out per class below. Adding a tab to an edit page means adding it
-# here too; the two lists drift silently otherwise, since nothing couples them.
- edit_path = public_send("edit_#{@klass.downcase}_path", @resource.id)
- container = @klass.in?(%w[Collection Community])
%ul.nav.nav-tabs
  %li.nav-item
    %a.nav-link{"aria-current" => "page", href: edit_path} Metadata
  -# Advanced is a Works-only tab (containers have no advanced fields).
  - if @klass == 'Work'
    %li.nav-item
      %a.nav-link{href: "#{edit_path}#advanced"} Advanced
  %li.nav-item
    %a.nav-link{href: "#{edit_path}#permissions"} Permissions
  -# Move / Delete are Works-only request tabs (containers have no
  -# request_change route).
  - if @klass == 'Work'
    %li.nav-item
      %a.nav-link{href: "#{edit_path}#move"} Move
    %li.nav-item
      %a.nav-link{href: "#{edit_path}#delete"} Delete
  %li.nav-item
    %a.nav-link.active{href: "#"} XML
  -# Derivative access / Export are Collection-only (a Sentinel is a Collection
  -# default; Export is additionally loader-gated, matching the edit page).
  - if @klass == 'Collection'
    %li.nav-item
      %a.nav-link{href: "#{edit_path}#derivative-access"} Derivative access
    - if current_user&.loader_tier?
      %li.nav-item
        %a.nav-link{href: "#{edit_path}#export"} Export
  - if can?(:read, :audit_event)
    %li.nav-item
      %a.nav-link{href: "#{edit_path}#history"} History
  -# Analytics is container-only — a Work has no subtree to report on.
  - if container
    %li.nav-item
      %a.nav-link{href: "#{edit_path}#analytics"} Analytics

%br

= form_tag xml_validate_path, :method => :put, :id => "raw_xml_form" do
  = hidden_field_tag "resource_id", @resource.id
  = hidden_field_tag "raw_xml"
  .container
    .row
      .col
        #editor<
          = @raw_xml
      .col#content{"data-controller" => "preview"}
        = @mods.html_safe
    .row
      .well.p-3.my-3.rounded-3
        %input#validate_button.btn.btn-primary{:name => "commit", :type => "submit", :value => "Validate + Preview", remote: true}/
        %input#save_button.btn.btn-success{"data-disable-with" => "Please wait...", :name => "commit", :type => "submit", :value => "Save", :formaction => xml_update_path}/
        %a.btn.btn-warning{"data-toggle" => "modal", :href => public_send("#{@klass.downcase}_path", @resource.id)}
          Cancel
