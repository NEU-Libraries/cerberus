- content_for(:container_header) do
  = render 'shared/breadcrumbs', show_add: false

-# The heading names the resource, so the page says what is being edited rather
-# than restating the trail's last crumb. Matches the XML editor, which is a
-# sub-tab of this page and has always named its resource.
%h3.py-3
  Edit Collection -
  = enhanced_text(@collection.title)

-# @open_tab is set by an action that re-renders this page and has to land the
-# reader back on the pane they were working in — a rejected Derivative access
-# save. Nil on an ordinary edit, which opens the first pane.
- open_tab = edit_tab_open_key('Collection', open: @open_tab)
= render 'shared/edit_tabs', klass: 'Collection', id: params[:id], active: nil, open: open_tab

.tab-content
  #metadata.tab-pane{class: ('active' if open_tab == 'metadata'), "aria-labelledby" => "metadata-tab", role: "tabpanel"}
    .py-2.px-1
      = bootstrap_form_tag(url: collection_path(params[:id]), method: :patch, multipart: true) do |f|
        %label.form-label{:for => "thumbnail"} Thumbnail
        %input#thumbnail.form-control.mb-3{:name => "thumbnail", :type => "file"}/
        = bootstrap_fields_for :collection do |c|
          = render 'shared/descriptive_fields', f: c, descriptive: @descriptive, keywords: false
        .well.p-3.my-3.rounded-3
          = f.button :submit, class: "btn btn-success"
          = link_to "Cancel", collection_path(params[:id]), class: "btn btn-warning"
  #permissions.tab-pane{"aria-labelledby" => "permissions-tab", role: "tabpanel"}
    -# narrowing-confirm watches this pane and puts a confirmation in front of a
    -# save that would take audience away: the change cascades to everything
    -# inside, and widening the collection again does not bring it back.
    .py-2.px-1{ data: { controller: "group-permissions narrowing-confirm",
                        "group-permissions-resource-value": "collection",
                        "narrowing-confirm-initial-value": Array(@read_groups).to_json,
                        "narrowing-confirm-affected-value": @narrowing_affected,
                        action: "change->narrowing-confirm#update click->narrowing-confirm#updateSoon" } }
      = bootstrap_form_tag(url: collection_path(params[:id]), method: :patch, multipart: true,
                           data: { "narrowing-confirm-target": "form" }) do |f|
        .row
          .col-sm
            = render 'shared/visibility_control', resource: 'collection'
        = render 'shared/group_permissions', resource: 'collection'
        %div
          .well.p-3.my-3.rounded-3
            = f.button :submit, class: "btn btn-success"
            = link_to "Cancel", collection_path(params[:id]), class: "btn btn-warning"
    - unless @narrowing_allowed
      = render 'shared/restriction_request', resource: 'collection'
  #derivative-access.tab-pane{class: ('active' if open_tab == 'derivative-access'), "aria-labelledby" => "derivative-access-tab", role: "tabpanel"}
    = render 'derivative_access', collection_id: params[:id], sentinel: @sentinel, groups: @groups, public_collection: @public
  - if edit_tab_visible?('export')
    #export.tab-pane{"aria-labelledby" => "export-tab", role: "tabpanel"}
      = render 'export', collection_id: params[:id]
  - if edit_tab_visible?('history')
    #history.tab-pane{"aria-labelledby" => "history-tab", role: "tabpanel"}
      = render 'audit_events/history', resource_id: params[:id]
  #analytics.tab-pane{"aria-labelledby" => "analytics-tab", role: "tabpanel"}
    = render 'shared/container_analytics'
