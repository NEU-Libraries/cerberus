-# MODS-history diff page, the deep view behind the audit log's "View" button
-# on MODS-document rows.
= render 'histories/version_diff',
         heading:      'MODS history',
         ledger_title: 'Descriptive-metadata versions',
         empty_title:  'No descriptive-metadata versions recorded',
         empty_hint:   "Edits to this resource's MODS document will appear here.",
         path:         mods_history_path(@resource_id)
