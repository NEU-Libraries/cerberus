- content_for :page_title, "Edit #{@set['title']}"

- content_for(:container_header) do
  = render 'shared/breadcrumbs', show_add: false

-# Which pane opens. Normally Details, but every bulk action has to return the
-# operator to the pane they acted in, and a fragment cannot carry that: Turbo
-# follows a redirect with fetch, and the Fetch spec strips the fragment from the
-# resolved URL, so `anchor:` arrives nowhere. A query param survives the
-# redirect. `@open_tab` covers the other case, a rejected save that re-renders
-# rather than redirecting, where there is no URL to read.
- open = params[:tab].presence || @open_tab.presence || 'details'

.container.my-2
  %h3.pb-2
    %i.fa-solid.fa-layer-group.text-primary.me-2{'aria-hidden' => 'true'}
    Edit set

  -# Details and Definition are open to any editor; Sharing (ACL) is owner/admin-only;
  -# Sentinel is operator-only, on the same predicate its write paths gate on
  -# (SetBulkActions#bulk_operator?).
  %ul.nav.nav-tabs{'data-controller' => 'tab-hash'}
    %li.nav-item
      %button#details-tab.nav-link{class: ('active' if open == 'details'), 'aria-controls' => 'details', 'aria-selected' => (open == 'details').to_s, 'data-bs-target' => '#details', 'data-bs-toggle' => 'tab', role: 'tab', type: 'button'} Details
    %li.nav-item
      %button#definition-tab.nav-link{class: ('active' if open == 'definition'), 'aria-controls' => 'definition', 'aria-selected' => (open == 'definition').to_s, 'data-bs-target' => '#definition', 'data-bs-toggle' => 'tab', role: 'tab', type: 'button'} Definition
    - if @owned
      %li.nav-item
        %button#sharing-tab.nav-link{class: ('active' if open == 'sharing'), 'aria-controls' => 'sharing', 'aria-selected' => (open == 'sharing').to_s, 'data-bs-target' => '#sharing', 'data-bs-toggle' => 'tab', role: 'tab', type: 'button'} Sharing
    - if bulk_operator?
      %li.nav-item
        %button#sentinel-tab.nav-link{class: ('active' if open == 'sentinel'), 'aria-controls' => 'sentinel', 'aria-selected' => (open == 'sentinel').to_s, 'data-bs-target' => '#sentinel', 'data-bs-toggle' => 'tab', role: 'tab', type: 'button'} Sentinel
    - if effective_user&.loader_tier?
      %li.nav-item
        %button#export-tab.nav-link{class: ('active' if open == 'export'), 'aria-controls' => 'export', 'aria-selected' => (open == 'export').to_s, 'data-bs-target' => '#export', 'data-bs-toggle' => 'tab', role: 'tab', type: 'button'} Export

  .tab-content.pt-1
    #details.tab-pane{class: ('active' if open == 'details'), 'aria-labelledby' => 'details-tab', role: 'tabpanel'}
      = render 'form', url: set_path(@set['id']), method: :patch, submit_label: 'Save', cancel_path: set_path(@set['id'])
    #definition.tab-pane{class: ('active' if open == 'definition'), 'aria-labelledby' => 'definition-tab', role: 'tabpanel'}
      .edit-pane
        = render 'definition', chips: @resolver.chips, added_noids: Array(@set['included_works']),
                               aside_docs: @resolver.aside_documents
    - if @owned
      #sharing.tab-pane{class: ('active' if open == 'sharing'), 'aria-labelledby' => 'sharing-tab', role: 'tabpanel'}
        .edit-pane
          = render 'sharing'
    - if bulk_operator?
      #sentinel.tab-pane{class: ('active' if open == 'sentinel'), 'aria-labelledby' => 'sentinel-tab', role: 'tabpanel'}
        = render 'sentinel', set_id: @set['id'], sentinel: @sentinel, groups: sentinel_groups
    - if effective_user&.loader_tier?
      #export.tab-pane{class: ('active' if open == 'export'), 'aria-labelledby' => 'export-tab', role: 'tabpanel'}
        = render 'export', set_id: @set['id']
