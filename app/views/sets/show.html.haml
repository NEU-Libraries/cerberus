- content_for(:page_title) do
  = @set['title']

- chips = @resolver.chips
- added_noids = Array(@set['included_works'])
- aside_docs = @resolver.aside_documents

= render 'sets/toast', chips: chips

-# The hero describes the whole set, so it rides :container_header and spans
-# the full main width. Anything outside that block
-# lands beside the facet sidebar in the narrow results column once the set has
-# contents.
- content_for(:container_header) do
  -# ===== Set hero =====
  .container.p-4.my-3.well.rounded-3
    - public_set = Array(@set['read_groups']).include?('public')
    .d-flex.align-items-center.flex-wrap.gap-2
      %h3.mb-0= @set['title']
      %h5.text-black-50.mb-0
        %span.fa-solid.fa-layer-group.pe-1
        Set
      - if public_set
        %span.badge.bg-success-subtle.text-success-emphasis.border.border-success-subtle.mt-1.ms-1
          %i.fa-solid.fa-globe.me-1{'aria-hidden' => 'true'}
          Public
    - if @set['description'].present?
      %p.mb-0.mt-3= @set['description']
    %p.recipe-line.small.mb-0{class: (@set['description'].present? ? 'mt-2' : 'mt-3')}
      = set_recipe_sentence(chips_count: chips.size, added_count: added_noids.size, aside_count: aside_docs.size)
    -# An admin or devolved admin gets the Reindex action on any set they can
    -# reach, including one they neither own nor may edit — so it opens this row
    -# on its own, not only alongside the owner's controls.
    - admin_tier = effective_user&.admin? || effective_user&.admin_delegate?
    - if public_set || @can_edit || @owned || admin_tier
      .d-flex.align-items-center.flex-wrap.gap-2.pt-3
        - if public_set
          %span{data: { controller: 'clipboard', 'clipboard-text-value': set_url(@set['id']) }}
            %button.btn.btn-tonal-secondary.btn-sm{type: 'button', 'aria-label' => 'Copy link to this set', data: { action: 'clipboard#copy' }}
              %i.fa-solid.fa-link.me-1{'aria-hidden' => 'true'}
              %span{data: { 'clipboard-target': 'label' }} Copy link
        - if @response.total.positive?
          = link_to download_set_path(@set['id']), class: 'btn btn-tonal-primary btn-sm', 'aria-label' => "Download #{@set['title']} as a zip", data: { turbo: false } do
            %i.fa-solid.fa-file-zipper.me-1{'aria-hidden' => 'true'}
            Download
        - if @can_edit || @owned || admin_tier
          .ms-auto
            -# Walks the recipe and rebuilds the search record of everything it
            -# names. Runs in the background, so this only starts it.
            - if admin_tier
              = button_to 'Reindex', admin_reindex_set_path(@set['id']),
                          class:      'btn btn-link link-action px-3',
                          form_class: 'd-inline',
                          title:      'Rebuild the search records this set names'
            - if @can_edit
              = link_to 'Manage', edit_set_path(@set['id']), class: 'px-3'
            - if @owned
              = link_to 'Delete', set_path(@set['id']), class: 'px-3',
                data: { turbo_method: :delete,
                        turbo_confirm: "Delete “#{@set['title']}”?\n\nThe works and collections it references are not deleted — only this set goes away." }

-# ===== Contents =====
- if @response.documents.present?
  - content_for(:sidebar) do
    = render 'catalog/search_sidebar'

- if @response.documents.present? || params[:q].present?
  .d-flex.align-items-center.flex-wrap.gap-2.mb-2
    .text-muted
      = page_entries_info(@response)
      in this set
    .ms-auto
      = render 'shared/scoped_search', path: set_path(@set['id']), label: 'Search this set'

  #set-results
    - @response.documents.each do |doc|
      - provenance = @resolver.provenance_for(doc)
      .result-row
        .thumb
          - if (thumb = renderable_thumbnail(doc.thumbnail_ssi) || av_placeholder_src(doc))
            = image_tag thumb, alt: '', loading: 'lazy'
          - else
            %i.fa-regular.fa-image{'aria-hidden' => 'true'}
        .flex-grow-1
          %h3
            = link_to set_document_title(doc), work_path(doc.to_param), class: 'text-decoration-none'
          .meta
            %span.nuid= doc.to_param
        .text-end.text-nowrap
          - if provenance
            .mb-2= set_provenance_badge(provenance, @recipe_titles)
          - if @can_edit
            = button_to set_aside_set_path(@set['id']), method: :post,
              params: { work_id: doc.to_param, title: set_document_title(doc), chip: (provenance.is_a?(String) ? provenance : nil) },
              class: 'btn btn-sm btn-tonal-secondary', form: { class: 'd-inline' } do
              %i.fa-solid.fa-eye-slash.me-1{'aria-hidden' => 'true'}
              Hide

  = render 'catalog/results_pagination'
- else
  .container.p-4.my-3.text-center.text-muted
    %i.fa-solid.fa-layer-group.fa-2x.mb-3.opacity-50{'aria-hidden' => 'true'}
    %p.mb-1 This set has no visible contents yet.
    - if @can_edit
      %p.small Search for a work or collection, then use “Add to set” on a result row to start filling it.
