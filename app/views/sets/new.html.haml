- content_for :page_title, 'New set'

.container.p-4.my-3.well.rounded-3
  %h3
    %i.fa-solid.fa-layer-group.text-primary.me-2{'aria-hidden' => 'true'}
    New set
  %p.text-muted
    A set gathers works from anywhere in the repository — whole collections or individual
    works — without moving or changing them. Once created, this Set can be selected from the
    “Add to Set” list for any work or collection.
  - if @pending
    %p.mb-0
      %i.fa-solid.fa-circle-info.text-primary.me-1{'aria-hidden' => 'true'}
      The #{@pending[:kind]} you chose will be added to this set when you create it.

= render 'form', url: sets_path, method: :post, submit_label: 'Create set',
                 cancel_path: @pending&.dig(:return_to) || sets_path, pending: @pending
