-# The hide teaching moment (flash[:aside], set by SetsController#set_aside).
-# Raised as a dark toast over the page: names what happened, anchors it to the
-# still-included collection with FRESH counts (the resolver has already
-# re-tallied on this render), reassures that the collection is unchanged, and
-# offers a one-click Undo (a plain put-back form — no client state).
- if flash[:aside].present?
  - aside = flash[:aside]
  - chip = aside['chip'].presence && chips.find { |c| c.noid == aside['chip'] }
  .toast-wrap
    .drs-toast{data: { controller: 'set-toast', action: 'focusin->set-toast#pause focusout->set-toast#resume' }}
      %i.fa-solid.fa-circle-info{'aria-hidden' => 'true'}
      -# Arrives empty; set_toast_controller.js fills it, so it is announced.
      .visually-hidden{role: 'status', data: { 'set-toast-target': 'announce' }}
      .flex-grow-1{data: { 'set-toast-target': 'message' }}
        Hid
        %b= aside['title']
        - if chip
          from this set. It's part of
          -# succeed glues the comma to the name; a bare line after it renders as " , which".
          = succeed ", which is still in your set (now showing #{number_with_delimiter(chip.live)} of #{number_with_delimiter(chip.total)}). The collection itself isn't changed." do
            %b= set_noun_label(chip.noid, @recipe_titles)
        - else
          (a work you'd added individually) from this set.
      = button_to put_back_set_path(@set['id'], work_id: aside['work_id']), method: :delete,
        class: 'btn btn-link undo p-0', form: { class: 'd-inline' } do
        Undo
