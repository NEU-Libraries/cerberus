-# locals: label (String), parts (Array of [text, path]) — see digest_figure.
-#
-# A definition list rather than stat tiles: these are a day's figures read in
-# sequence, not headline metrics. Each figure that has something behind it
-# links to the surface listing it, so the digest indexes the day.
%div
  %dt.ledger-digest__count-label= label
  %dd.ledger-digest__count-value
    = safe_join(parts.map { |text, path| path ? link_to(text, path) : text }, ' · ')
