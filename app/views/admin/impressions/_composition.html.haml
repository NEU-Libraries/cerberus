-# locals: composition (RepositoryCompositionReport), scope_phrase (String,
-# optional), scope_klass (String, optional) — the scoped item's class, nil for
-# the whole repository.
- entity = composition.entity_counts
- visibility = composition.work_visibility
- scope_phrase ||= 'across the DRS'
- types = composition_entity_types(local_assigns[:scope_klass])
- modifiers = { 'Community' => 'communities', 'Collection' => 'collections', 'Work' => 'works', 'Person' => 'people' }

%p.text-muted.small.mb-3
  Unfiltered counts of the #{composition_counted_phrase(types)} #{scope_phrase}. Storage used counts every stored version of every file, removed files included.

%dl.usage-ledger
  - types.each do |type|
    .usage-ledger__item{class: "usage-ledger__item--#{modifiers.fetch(type)}"}
      %dt.usage-ledger__label= Admin::ImpressionsHelper::COMPOSITION_LABELS.fetch(type)
      %dd.usage-ledger__figure= number_with_delimiter(entity[type])

%dl.usage-ledger
  .usage-ledger__item
    %dt.usage-ledger__label Storage used
    %dd.usage-ledger__figure= number_to_human_size(composition.storage_bytes)
  .usage-ledger__item.usage-ledger__item--public
    %dt.usage-ledger__label Public works
    %dd.usage-ledger__figure= number_with_delimiter(visibility[:public])
  .usage-ledger__item.usage-ledger__item--private
    %dt.usage-ledger__label Private works
    %dd.usage-ledger__figure= number_with_delimiter(visibility[:private])

%section.usage-chart-block
  %h2.usage-chart-block__title Content by type
  - if composition.classification_counts.any?
    .usage-chart{data: {controller: 'usage-chart', 'usage-chart-kind-value' => 'pie', 'usage-chart-dataset-value' => composition.classification_counts.to_json, 'usage-chart-colors-value' => usage_composition_colors.to_json}}
  - else
    .admin-registry__empty
      %i.fa-solid.fa-chart-simple.admin-registry__empty-icon{'aria-hidden' => 'true'}
      %p.text-muted.mb-0 No classified content yet.
