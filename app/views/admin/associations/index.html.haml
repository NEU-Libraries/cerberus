= render 'admin/breadcrumb_header'

.admin-registry.my-3
  %header.admin-registry__head
    %span.admin-registry__title
      %i.fa-solid.fa-diagram-project{'aria-hidden' => 'true'}
      Associated works
    .admin-registry__head-actions
      %span.admin-registry__subtitle
        %i.fa-solid.fa-lock{'aria-hidden' => 'true'}
        Admin-only

  .p-3
    %p.text-muted.small.mb-3
      Find the Work whose associations you want to manage. An association records that one Work is the codebook, figure, transcription, instructional material or supplemental material for another. It is descriptive only — nothing moves, and no permissions change.
    = render 'admin/finder/search_form', url: admin_associations_path, q: params[:q], hidden: {}, placeholder: 'Search works by title…'

  - if @results
    = render 'admin/finder/results', results: @results, select_label: 'Manage', select_url: ->(doc) { admin_associations_manage_path(work_id: doc.to_param) }
