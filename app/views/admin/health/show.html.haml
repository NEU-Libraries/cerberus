= render 'admin/breadcrumb_header'

- down = @results.values.reject(&:ok)
.admin-registry.my-3
  %header.admin-registry__head
    %span.admin-registry__title
      %i.fa-solid.fa-heart-pulse{'aria-hidden' => 'true'}
      System health
      %span.admin-registry__count= down.empty? ? 'All services answering' : "#{pluralize(down.size, 'service')} down"
    .admin-registry__head-actions
      = link_to admin_health_path, class: 'btn btn-tonal-secondary btn-sm' do
        %i.fa-solid.fa-rotate.me-1{'aria-hidden' => 'true'}
        Check again

  .p-3.pb-0
    %p.text-body-secondary.small.mb-2
      Checked #{l(@checked_at, format: :long)}. Readers see only the capability
      names, on the outage page and at #{link_to '/health', health_path}, which
      Nagios polls. This page cannot open while Postgres is down, because
      signing in needs it; the public endpoint still reports it.

  -# A label rather than a visually-hidden caption: the caption overflows
  -# .table-responsive by a pixel and puts a scrollbar on the table.
  .table-responsive
    %table.table.table-borderless.admin-registry-table{'aria-label' => 'Each service the repository depends on, and whether it answered'}
      %thead
        %tr
          %th{scope: 'col'} Capability
          %th{scope: 'col'} Service
          %th{scope: 'col'} State
          %th.text-end{scope: 'col'} Response
          %th{scope: 'col'} Detail
      %tbody
        - @results.each_value do |result|
          %tr
            %td
              .admin-registry-table__name= result.capability.to_s.humanize
            %td= result.service
            %td
              - if result.ok
                %span.text-success
                  %i.fa-solid.fa-circle-check.me-1{'aria-hidden' => 'true'}
                  OK
              - else
                %span.text-danger.fw-semibold
                  %i.fa-solid.fa-circle-xmark.me-1{'aria-hidden' => 'true'}
                  Unavailable
            %td.text-end
              %span.admin-registry-table__id= "#{result.latency_ms} ms"
            %td.small.text-break= result.detail

-# Readouts, not forms, so each is a bare card body under its header strip.
.admin-registry.my-3
  %header.admin-registry__head
    %span.admin-registry__title
      %i.fa-solid.fa-gears{'aria-hidden' => 'true'}
      Background jobs
      - if @jobs
        %span.admin-registry__count= "#{@jobs.waiting} waiting · #{@jobs.running} running"
    .admin-registry__head-actions
      = link_to '/jobs', class: 'btn btn-tonal-secondary btn-sm' do
        %i.fa-solid.fa-arrow-up-right-from-square.me-1{'aria-hidden' => 'true'}
        Open Mission Control
  - if @jobs.nil?
    %p.p-3.mb-0.text-body-secondary The job queue database did not answer.
  - else
    .table-responsive
      %table.table.table-borderless.admin-registry-table{'aria-label' => 'The background job queue now'}
        %tbody
          %tr
            %td.w-25
              .admin-registry-table__name Waiting
            %td
              %span.admin-registry-table__id= @jobs.waiting
              - if @jobs.waiting_by_queue.any?
                %span.small.text-body-secondary.ms-2
                  = @jobs.waiting_by_queue.map { |queue, count| "#{queue} #{count}" }.join(' · ')
          %tr
            %td
              .admin-registry-table__name Oldest waiting
            %td
              - if @jobs.oldest_waiting_at
                = distance_of_time_in_words_to_now(@jobs.oldest_waiting_at)
              - else
                %span.text-body-secondary Nothing waiting
          %tr
            %td
              .admin-registry-table__name Running
            %td
              %span.admin-registry-table__id= @jobs.running
              %span.small.text-body-secondary.ms-2
                = "on #{pluralize(@jobs.workers, 'live worker')}; a worker stopped in the last two minutes can still count"
          %tr
            %td
              .admin-registry-table__name Scheduled
            %td
              %span.admin-registry-table__id= @jobs.scheduled
          %tr
            %td
              .admin-registry-table__name Blocked
            %td
              %span.admin-registry-table__id= @jobs.blocked
          %tr
            %td
              .admin-registry-table__name Failed
            %td
              %span.admin-registry-table__id{class: ('text-danger' if @jobs.failed.positive?)}= @jobs.failed

.admin-registry.my-3
  %header.admin-registry__head
    %span.admin-registry__title
      %i.fa-solid.fa-gauge-high{'aria-hidden' => 'true'}
      Atlas response times
      %span.admin-registry__count Last #{LatencyHistogram::WINDOW_MINUTES} minutes
  .table-responsive
    %table.table.table-borderless.admin-registry-table{'aria-label' => 'Atlas response times over the last hour, measured by each side'}
      %thead
        %tr
          %th{scope: 'col'} Measured by
          %th.text-end{scope: 'col'} Calls
          %th.text-end{scope: 'col'} Failed
          %th.text-end{scope: 'col'} Timeouts
          %th.text-end{scope: 'col'} Mean
          %th.text-end{scope: 'col'} p50
          %th.text-end{scope: 'col'} p95
          %th.text-end{scope: 'col'} p99
      %tbody
        %tr
          %td
            .admin-registry-table__name Atlas, action only
          - if @atlas_served.nil?
            %td.text-body-secondary{colspan: 7} Atlas could not give its figures.
          - elsif @atlas_served.calls.to_i.zero?
            %td.text-body-secondary{colspan: 7} Atlas served no requests in this window.
          - else
            = render 'admin/health/latency_cells', calls: @atlas_served.calls, failed: @atlas_served.server_errors,
                                                   timeouts: nil, figures: @atlas_served
        %tr
          %td
            .admin-registry-table__name Cerberus, waiting
          - if @atlas.nil?
            %td.text-body-secondary{colspan: 7} Redis did not answer, so there are no figures to show.
          - elsif @atlas.calls.zero?
            %td.text-body-secondary{colspan: 7} No calls to Atlas in this window.
          - else
            = render 'admin/health/latency_cells', calls: @atlas.calls, failed: @atlas.failed,
                                                   timeouts: @atlas.timeouts, figures: @atlas
  - slowest = Array(@atlas_served&.slowest_actions).first(5)
  - if slowest.any?
    .px-3.pt-2
      %h2.h6.mb-1 Slowest Atlas actions
    .table-responsive
      %table.table.table-borderless.admin-registry-table{'aria-label' => "Atlas's slowest actions by p95 over the last hour"}
        %thead
          %tr
            %th{scope: 'col'} Action
            %th.text-end{scope: 'col'} Calls
            %th.text-end{scope: 'col'} p95
        %tbody
          - slowest.each do |action|
            %tr
              %td
                %span.admin-registry-table__id= action.action
              %td.text-end
                %span.admin-registry-table__id= action.calls
              %td.text-end
                %span.admin-registry-table__id= "#{action.p95_ms} ms"
  %p.px-3.pb-3.mb-0.small.text-body-secondary
    Atlas times only the controller action. Cerberus times each call from
    sending it until it has read the answer, so its figures also include the
    rest of Atlas's handling. Most of the gap between the two rows is a request
    waiting inside Atlas for its turn when several arrive at once; Cerberus and
    the network add a few milliseconds. Both sets of percentiles are
    interpolated from latency buckets, so they are approximate, and a retried
    call counts once per attempt.
