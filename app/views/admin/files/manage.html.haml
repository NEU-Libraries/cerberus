= render 'admin/breadcrumb_header'

.admin-actions.my-3
  %header.admin-actions__head
    %span.admin-actions__title
      %i.fa-solid.fa-arrows-rotate{'aria-hidden' => 'true'}
      Replace a file

  %p.admin-actions__lede
    Replacing a file in
    %strong= enhanced_text(@work.title)
    creates a new version while keeping the same identifier. Each version keeps its own filename. Previous versions can be managed below.
    Removing a file takes it off the work while the work and its other files stay up, and it can be restored at the bottom of this page.

- if @blobs.empty?
  .admin-registry.my-3
    .admin-registry__empty
      %i.fa-solid.fa-file.admin-registry__empty-icon{'aria-hidden' => 'true'}
      %p.mb-0.small.text-muted This work has no replaceable files.

- @blobs.each do |row|
  - asset = row[:asset]
  - versions = row[:versions]
  .admin-registry.my-3
    %header.admin-registry__head
      %span.admin-registry__title
        %i.fa-solid.me-1{class: file_type_icon(asset.mime_type), 'aria-hidden' => 'true'}
        = asset.label.presence || asset[:use] || 'File'
        - if versions.any?
          %span.admin-registry__count= pluralize(versions.size, 'version')
      .admin-registry__head-actions
        - if asset[:size]
          %span.admin-registry__subtitle= number_to_human_size(asset[:size])
        %span.admin-registry-table__id= asset.noid
        -# Removing tombstones the file's FileSet, so the confirm names anything
        -# else stored with it, which leaves the work too.
        - name = asset.label.presence || asset[:use] || 'File'
        - siblings = @blobs.map { |other| other[:asset] }.select { |other| other.file_set == asset.file_set && other.noid != asset.noid }
        - also = siblings.any? ? " #{siblings.map { |other| other.label.presence || other.noid }.to_sentence} #{siblings.one? ? 'is' : 'are'} stored with it and will be removed too." : ''
        = button_to admin_files_remove_path, method: :post, params: { work_id: params[:work_id], blob_noid: asset.noid },
                    class: 'btn btn-tonal-danger btn-sm', form_class: 'd-inline', 'aria-label' => "Remove #{name}",
                    form: { data: { turbo_confirm: "Remove #{name} from this work?#{also} It leaves the work page and the downloads, and can be restored from this page.",
                                    turbo_confirm_title: 'Remove file', turbo_confirm_button: 'Remove', turbo_confirm_variant: 'danger' } } do
          %i.fa-solid.fa-trash-can.me-1{'aria-hidden' => 'true'}
          Remove

    .admin-registry__body
      = form_with url: admin_files_replace_path, method: :post, multipart: true do
        = hidden_field_tag :work_id, params[:work_id]
        = hidden_field_tag :blob_noid, asset.noid
        .row.g-2.align-items-end
          .col-sm
            %label.admin-registry-form__label{for: "binary-#{asset.noid}"}
              %i.fa-solid.fa-arrow-up-from-bracket{'aria-hidden' => 'true'}
              Upload a replacement
            = render layout: 'shared/file_field', locals: { small: true } do
              %input.file-field__input{id: "binary-#{asset.noid}", name: 'binary', type: 'file', required: true}
          .col-sm-auto
            %button.btn.btn-primary.btn-sm{type: 'submit'}
              %i.fa-solid.fa-arrows-rotate.me-1{'aria-hidden' => 'true'}
              Replace file
        %p.admin-registry-form__hint.mt-1
          Select the file you would like to use as the most recent version. Older versions will be retained.

    - if versions.any?
      .table-responsive
        %table.table.table-borderless.admin-registry-table
          %thead
            %tr
              %th{scope: 'col'} Version
              %th{scope: 'col'} Filename
              %th{scope: 'col'} Date Deposited
              %th{scope: 'col'} Depositor
              %th{scope: 'col'} Fixity
              %th.text-end{scope: 'col'} Actions
          %tbody
            - versions.each_with_index do |version, i|
              %tr
                %td
                  -# The contiguous revision ordinal is the only number shown. The raw
                  -# OCFL version_id can skip (v1 → v4) when preservation-envelope
                  -# bumps consume OCFL versions, which reads as a second, gappy
                  -# numbering, so it survives only as a tooltip for debugging.
                  %span.admin-registry-table__id{title: ("OCFL #{version['version_id']}" if version['revision'].present?)}= version['revision'] || version['version_id']
                  - if i.zero?
                    %span.badge.rounded-pill.text-bg-light.ms-1 current
                %td.text-break= version['original_filename'].presence || '—'
                %td.text-muted.small{style: 'font-variant-numeric: tabular-nums'}= file_version_when(version['created'])
                %td= file_version_who(version['actor_nuid'])
                %td= file_version_digest(version['digest'])
                %td.text-end
                  = link_to admin_file_version_content_path(asset.noid, version['version_id']), class: 'admin-registry-table__edit', data: { turbo: false } do
                    %i.fa-solid.fa-download{'aria-hidden' => 'true'}
                    Download
                  - unless i.zero?
                    -# Confirms like every other consequential control here (Delete,
                    -# Regenerate). Revert is non-destructive — it adds a version
                    -# rather than removing one — but it swaps the file every viewer
                    -# downloads and re-derives the renditions, so it should not
                    -# happen on a mis-click in a table of near-identical rows.
                    = button_to admin_files_rollback_path, method: :post, params: { work_id: params[:work_id], blob_noid: asset.noid, version_id: version['version_id'], revision: version['revision'] }, class: 'admin-registry-table__edit admin-registry-table__edit--restore ms-1', form_class: 'd-inline', form: { data: { turbo_confirm: "Revert to version #{version['revision']}? It becomes the current file and the download renditions are rebuilt from it. Nothing is deleted — the version you are leaving stays in the history." } } do
                      %i.fa-solid.fa-rotate-left{'aria-hidden' => 'true'}
                      Revert

-# Removed files are tombstoned, not deleted: Atlas keeps them, every version
-# included, until someone restores them here.
- if @removed.any?
  .admin-registry.my-3
    %header.admin-registry__head
      %span.admin-registry__title
        %i.fa-solid.fa-trash-can-arrow-up{'aria-hidden' => 'true'}
        Removed files
        %span.admin-registry__count= @removed.size
    .table-responsive
      %table.table.table-borderless.admin-registry-table
        %thead
          %tr
            %th{scope: 'col'} File
            %th{scope: 'col'} Removed
            %th{scope: 'col'} By
            %th.text-end{scope: 'col'} Actions
        %tbody
          - @removed.each do |asset|
            - name = asset.label.presence || asset[:original_filename].presence || asset[:use] || 'File'
            %tr
              %td
                %span.admin-registry-table__name= name
                %span.admin-registry-table__id.ms-2= asset.noid
              %td.text-muted.small{style: 'font-variant-numeric: tabular-nums'}= file_version_when(asset[:tombstoned_at])
              %td= file_version_who(asset[:tombstoned_by])
              %td.text-end
                = button_to admin_files_restore_path, method: :post, params: { work_id: params[:work_id], file_set_id: asset.file_set },
                            class: 'admin-registry-table__edit admin-registry-table__edit--restore', form_class: 'd-inline',
                            'aria-label' => "Restore #{name}" do
                  %i.fa-solid.fa-rotate-left{'aria-hidden' => 'true'}
                  Restore
