= render 'admin/breadcrumb_header'

.admin-registry.my-3
  %header.admin-registry__head
    %span.admin-registry__title
      %i.fa-solid.fa-arrows-rotate{'aria-hidden' => 'true'}
      Replace a file
    .admin-registry__head-actions
      %span.admin-registry__subtitle
        - if current_user&.admin?
          %i.fa-solid.fa-lock{'aria-hidden' => 'true'}
          Admin-only
        - else
          %i.fa-solid.fa-user-shield{'aria-hidden' => 'true'}
          Delegated admin access

  .p-3
    %p.text-muted.small.mb-3
      Search for the work with the file you want to replace. Replacing a file adds a new version but keeps the same identifier. Previous versions can be managed from the Administration page.
    = render 'admin/finder/search_form', url: admin_files_path, q: params[:q], hidden: {}, placeholder: 'Search works by title…'

  - if @results
    = render 'admin/finder/results', results: @results, select_label: 'Manage files', select_url: ->(doc) { admin_files_manage_path(work_id: doc.to_param) }
